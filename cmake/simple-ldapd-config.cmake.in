    simple-ldapd_INSTALL_PREFIX
    simple-ldapd_BIN_DIR
    simple-ldapd_LIB_DIR
    simple-ldapd_INCLUDE_DIR
    simple-ldapd_CONFIG_DIR
    simple-ldapd_DEPLOYMENT_DIR
    simple-ldapd_DOCS_DIR
    simple-ldapd_LOG_DIR
    simple-ldapd_RUN_DIR
    simple-ldapd_FOUND
    simple-ldapd_INCLUDE_DIRS
    simple-ldapd_LIBRARY_DIRS
    simple-ldapd_RUNTIME_DIRS
    simple-ldapd_CONFIG_DIRS
    simple-ldapd_DEPLOYMENT_DIRS
    simple-ldapd_DOCS_DIRS
    simple-ldapd_LOG_DIRS
    simple-ldapd_RUN_DIRS
)

# Export all package variables
foreach(var ${simple-ldapd_EXPORTED_VARS})
    set(${var} ${${var}} PARENT_SCOPE)
