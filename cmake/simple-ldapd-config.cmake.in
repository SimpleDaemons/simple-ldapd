# simple-ldapd CMake Configuration File
# This file is generated by CMake and should not be edited manually

@PACKAGE_INIT@

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/simple-ldapd-targets.cmake")

# Set package properties
set(simple-ldapd_VERSION "@PROJECT_VERSION@")
set(simple-ldapd_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(simple-ldapd_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(simple-ldapd_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

# Set package description
set(simple-ldapd_DESCRIPTION "Simple LDAP Daemon - A lightweight directory service")

# Set package homepage
set(simple-ldapd_HOMEPAGE "https://github.com/simple-ldapd/simple-ldapd")

# Set package maintainer
set(simple-ldapd_MAINTAINER "support@blburns.com")

# Set package license
set(simple-ldapd_LICENSE "Apache-2.0")

# Set package category
set(simple-ldapd_CATEGORY "net")

# Set package keywords
set(simple-ldapd_KEYWORDS "ldap;directory;daemon;sso;authentication")

# Set package dependencies
set(simple-ldapd_DEPENDENCIES "OpenSSL;jsoncpp")

# Set package features
set(simple-ldapd_FEATURES "SSL;JSON_CONFIG;LOGGING;MULTI_INSTANCE")

# Set package components
set(simple-ldapd_COMPONENTS "runtime;library;headers;config;deployment;docs")

# Set package installation paths
if(APPLE)
    set(simple-ldapd_INSTALL_PREFIX "/usr/local")
    set(simple-ldapd_BIN_DIR "${simple-ldapd_INSTALL_PREFIX}/bin")
    set(simple-ldapd_LIB_DIR "${simple-ldapd_INSTALL_PREFIX}/lib")
    set(simple-ldapd_INCLUDE_DIR "${simple-ldapd_INSTALL_PREFIX}/include")
    set(simple-ldapd_CONFIG_DIR "${simple-ldapd_INSTALL_PREFIX}/etc/simple-ldapd")
    set(simple-ldapd_DEPLOYMENT_DIR "${simple-ldapd_INSTALL_PREFIX}/share/simple-ldapd")
    set(simple-ldapd_DOCS_DIR "${simple-ldapd_INSTALL_PREFIX}/share/simple-ldapd/docs")
    set(simple-ldapd_LOG_DIR "${simple-ldapd_INSTALL_PREFIX}/var/log/simple-ldapd")
    set(simple-ldapd_RUN_DIR "${simple-ldapd_INSTALL_PREFIX}/var/run/simple-ldapd")
elseif(WIN32)
    set(simple-ldapd_INSTALL_PREFIX "C:/Program Files/simple-ldapd")
    set(simple-ldapd_BIN_DIR "${simple-ldapd_INSTALL_PREFIX}/bin")
    set(simple-ldapd_LIB_DIR "${simple-ldapd_INSTALL_PREFIX}/lib")
    set(simple-ldapd_INCLUDE_DIR "${simple-ldapd_INSTALL_PREFIX}/include")
    set(simple-ldapd_CONFIG_DIR "${simple-ldapd_INSTALL_PREFIX}/config")
    set(simple-ldapd_DEPLOYMENT_DIR "${simple-ldapd_INSTALL_PREFIX}/deployment")
    set(simple-ldapd_DOCS_DIR "${simple-ldapd_INSTALL_PREFIX}/docs")
    set(simple-ldapd_LOG_DIR "${simple-ldapd_INSTALL_PREFIX}/logs")
    set(simple-ldapd_RUN_DIR "${simple-ldapd_INSTALL_PREFIX}/temp")
else()
    set(simple-ldapd_INSTALL_PREFIX "/usr/local")
    set(simple-ldapd_BIN_DIR "/usr/bin")
    set(simple-ldapd_LIB_DIR "/usr/lib")
    set(simple-ldapd_INCLUDE_DIR "/usr/include")
    set(simple-ldapd_CONFIG_DIR "/etc/simple-ldapd")
    set(simple-ldapd_DEPLOYMENT_DIR "/usr/share/simple-ldapd")
    set(simple-ldapd_DOCS_DIR "/usr/share/simple-ldapd/docs")
    set(simple-ldapd_LOG_DIR "/var/log/simple-ldapd")
    set(simple-ldapd_RUN_DIR "/var/run/simple-ldapd")
endif()

# Set package variables for use in other CMake files
set(simple-ldapd_FOUND TRUE)
set(simple-ldapd_INCLUDE_DIRS "${simple-ldapd_INCLUDE_DIR}")
set(simple-ldapd_LIBRARY_DIRS "${simple-ldapd_LIB_DIR}")
set(simple-ldapd_RUNTIME_DIRS "${simple-ldapd_BIN_DIR}")
set(simple-ldapd_CONFIG_DIRS "${simple-ldapd_CONFIG_DIR}")
