<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simpledaemons.simple-ldapd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/simple-ldapd</string>
        <string>--config</string>
        <string>/etc/simple-ldapd/simple-ldapd.conf</string>
        <string>--foreground</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/simple-ldapd/simple-ldapd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/simple-ldapd/simple-ldapd.error.log</string>
</dict>
</plist>
