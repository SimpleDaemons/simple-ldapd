/var/log/simple-ldapd/*.log {
    daily
    missingok
    rotate 52
    compress
    delaycompress
    notifempty
    create 644 _simple-ldapd _simple-ldapd
    postrotate
        /bin/systemctl reload simple-ldapd > /dev/null 2>&1 || true
    endscript
    sharedscripts
    su _simple-ldapd _simple-ldapd
}
