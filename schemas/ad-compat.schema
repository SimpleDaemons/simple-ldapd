# Active Directory compatibility attributes
# Enough names for apps that bind/search with sAMAccountName / memberOf.
# `user` is auxiliary so it can sit beside inetOrgPerson. This is not a DC.

attributetype ( 1.2.840.113556.1.4.221 NAME 'sAMAccountName'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.2.102 NAME 'memberOf'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

attributetype ( 1.2.840.113556.1.4.8 NAME 'userAccountControl'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.146 NAME 'objectSid'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.656 NAME 'userPrincipalName'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.44 NAME 'objectGUID'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.194 NAME 'objectCategory'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.141 NAME 'lastLogon'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.96 NAME 'pwdLastSet'
  EQUALITY integerMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  SINGLE-VALUE )

attributetype ( 1.2.840.113556.1.4.261 NAME 'unicodePwd'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 )

attributetype ( 1.2.840.113556.1.4.659 NAME 'dNSHostName'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 2.5.4.31 NAME 'member'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )

objectclass ( 1.2.840.113556.1.5.9 NAME 'user' SUP top AUXILIARY
  MAY ( sAMAccountName $ memberOf $ userAccountControl $ objectSid
        $ userPrincipalName $ objectGUID $ objectCategory $ lastLogon
        $ pwdLastSet $ unicodePwd $ mail $ uid $ displayName $ givenName ) )

objectclass ( 1.2.840.113556.1.5.8 NAME 'group' SUP top STRUCTURAL
  MUST cn
  MAY ( member $ memberUid $ gidNumber $ sAMAccountName $ memberOf
        $ description $ userAccountControl ) )

objectclass ( 1.2.840.113556.1.5.1 NAME 'computer' SUP top STRUCTURAL
  MUST cn
  MAY ( sAMAccountName $ userAccountControl $ objectSid $ objectGUID
        $ dNSHostName $ description ) )
