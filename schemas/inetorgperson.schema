# RFC 2798 inetOrgPerson schema subset

attributetype ( 2.16.840.1.113730.3.1.241 NAME 'displayName'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 0.9.2342.19200300.100.1.60 NAME 'jpegPhoto'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.28 )

attributetype ( 2.16.840.1.113730.3.1.2 NAME 'employeeNumber'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 2.16.840.1.113730.3.1.3 NAME 'employeeType'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 2.16.840.1.113730.3.1.39 NAME 'preferredLanguage'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

objectclass ( 2.16.840.1.113730.3.2.2 NAME 'inetOrgPerson' SUP organizationalPerson STRUCTURAL
  MAY ( displayName $ jpegPhoto $ employeeNumber $ employeeType $ preferredLanguage
        $ givenName $ mail $ manager $ mobile $ departmentNumber $ uid
        $ telephoneNumber $ o $ userPassword $ description ) )
